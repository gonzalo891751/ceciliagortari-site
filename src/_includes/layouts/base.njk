<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
    <link rel="canonical" href="https://ceciliagortari.com.ar{{ page.url }}">

    <!-- Open Graph -->
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:type" content="{{ ogType | default('website') }}">
    <meta property="og:url" content="https://ceciliagortari.com.ar{{ page.url }}">
    <meta property="og:image" content="{{ ogImage | default('https://ceciliagortari.com.ar/assets/img/hero-diputados.jpg') }}">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="{{ ogImage | default('https://ceciliagortari.com.ar/assets/img/hero-diputados.jpg') }}">

    {% if jsonLd %}
    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
    {{ jsonLd | safe }}
    </script>
    {% endif %}

    <!-- Monograma CG: URLs estables para navegadores y Google Search. -->
    <link rel="icon" href="/favicon.ico" type="image/vnd.microsoft.icon" sizes="16x16 32x32 48x48">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-cg-48x48.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-cg-96x96.png">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#11103B">
    <meta name="apple-mobile-web-app-title" content="Cecilia Gortari">

    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;900&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            magenta: '#9F57A7',
                            blue: '#1C5CFF',
                            turquoise: '#24BCDE',
                            orange: '#FBA85F',
                            dark: '#2C2C31',
                            light: '#F7F7FD',
                            institucional: '#11103B',
                            rosa: '#E4BFE8',
                            darkblue: '#11103B',
                            darkgray: '#4E4E54',
                            pink: '#E4BFE8'
                        }
                    },
                    boxShadow: {
                        'soft': '0 10px 40px -10px rgba(17, 16, 59, 0.08)',
                        'hover': '0 20px 40px -10px rgba(28, 92, 255, 0.15)',
                    }
                }
            }
        }
    </script>

    <!-- Site CSS -->
    <link rel="stylesheet" href="/assets/css/site.css?v=202603181200">
    <link rel="stylesheet" href="/assets/css/additions.css?v=202610231000">
    
    {% if identityWidget %}
    <!-- Netlify Identity & Redirect -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script>
        if (window.location.hash.includes("recovery_token") || window.location.hash.includes("invite_token")) {
            window.location.href = "/admin/" + window.location.hash;
        }
    </script>
    {% endif %}

    <!-- Extra Head Content -->
    {% if extraCSS %}
    {% for hoja in ([extraCSS] if extraCSS is string else extraCSS) %}
    <link rel="stylesheet" href="{{ hoja }}">
    {% endfor %}
    {% endif %}
    {% block head %}{% endblock %}
</head>

<body class="{{ bodyClass }} font-sans text-brand-dark bg-brand-light antialiased">
    
    {% include "partials/navbar.njk" %}

    {{ content | safe }}

    {% include "partials/footer.njk" %}

    {% block scripts %}
    <script src="/assets/js/site.js?v=202610231000"></script>
    {% endblock %}
</body>

</html>
