          <div class="esc-field">
            <label class="esc-field__label" for="alumno-curso">Curso de interés <span class="esc-field__req" aria-hidden="true">*</span></label>
            <select class="esc-select" id="alumno-curso" name="curso" required aria-describedby="alumno-curso-error">
              <option value="">Elegí una opción…</option>
              {%- for group in escuela.upcomingByMonth %}
              <optgroup label="{{ group.label }}">
                {%- for course in group.courses %}
                <option value="{{ course.name }}">{{ course.name }} — {{ course.dateLabel }}, {{ course.time }} h</option>
                {%- endfor %}
              </optgroup>
              {%- endfor %}
              {%- if escuela.started.length %}
              <optgroup label="Ya comenzaron">
                {%- for course in escuela.started %}
                <option value="{{ course.name }}">{{ course.name }} — {{ course.dateLabel }}, {{ course.time }} h</option>
                {%- endfor %}
              </optgroup>
              {%- endif %}
              <option value="Otro curso o habilidad">Otro curso o habilidad</option>
            </select>
            <p class="esc-error" id="alumno-curso-error" data-error-for="curso"></p>
          </div>

          <div class="esc-field">
            <label class="esc-field__label" for="alumno-mensaje">Consulta o comentario <span class="esc-field__hint" style="display:inline">(opcional)</span></label>
            <textarea class="esc-textarea" id="alumno-mensaje" name="mensaje" maxlength="1500"
                      placeholder="Contanos qué te gustaría aprender o qué duda tenés."></textarea>
          </div>

          <div class="esc-check">
            <input type="checkbox" id="alumno-consent" name="consentimiento" required
                   aria-describedby="alumno-consent-error">
            <label for="alumno-consent">
              Acepto que me contacten por los cursos y actividades de la Escuela de Emprendedores.
              <span class="esc-field__req" aria-hidden="true">*</span>
            </label>
          </div>
          <p class="esc-error" id="alumno-consent-error" data-error-for="consentimiento"></p>

          {%- if escuela.turnstileSiteKey %}
          <div class="cf-turnstile" data-sitekey="{{ escuela.turnstileSiteKey }}" data-language="es" style="margin-bottom:1rem"></div>
          {%- endif %}

          <button type="submit" class="esc-btn esc-btn--primary esc-btn--block" data-submit>
            Quiero recibir información
          </button>

          <p class="esc-status" role="status" aria-live="polite" data-status></p>

          <p class="esc-privacy">
            Usaremos estos datos únicamente para comunicarnos con vos en relación con los
            cursos y actividades de la Escuela de Emprendedores.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

