---
layout: layouts/base.njk
title: "Proyectos Legislativos | Cecilia Gortari"
description: "Consultá, leé los fundamentos y descargá los documentos originales de todos los proyectos legislativos presentados por Cecilia Gortari en la Cámara de Diputados de Corrientes."
ogImage: "https://ceciliagortari.com.ar/assets/img/hero-diputados.jpg"
---

    <!-- Hero Section -->
    <section class="pl-hero">
        <div class="container">
            <h1>Proyectos Legislativos</h1>
            <p class="pl-subtitle">Iniciativas presentadas en la Cámara de Diputados de Corrientes.</p>
            <p class="pl-transparency">Acá podés consultar, leer los fundamentos y descargar los documentos originales de todos los proyectos presentados durante la gestión.</p>
        </div>
    </section>

    <!-- Filtros -->
    <section class="pl-filters">
        <div class="container">
            <div class="pl-filters-grid">
                <div class="pl-filter-group pl-search-group">
                    <label for="plSearchInput">Buscar Proyecto</label>
                    <svg class="pl-filter-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    <input type="text" id="plSearchInput" class="pl-filter-input" placeholder="Título, tema, palabra clave...">
                </div>

                <div class="pl-filter-group">
                    <label for="plTipoFilter">Tipo de Proyecto</label>
                    <select id="plTipoFilter" class="pl-filter-input">
                        <option value="Todos">Todos</option>
                        <option value="Proyecto de Ley">Ley</option>
                        <option value="Proyecto de Resolución">Resolución</option>
                        <option value="Proyecto de Declaración">Declaración</option>
                        <option value="Pedido de informe">Pedido de Informe</option>
                    </select>
                </div>

                <div class="pl-filter-group">
                    <label for="plAreaFilter">Área</label>
                    <select id="plAreaFilter" class="pl-filter-input">
                        <option value="Todas">Todas</option>
                        <!-- Populated dynamically from API data -->
                    </select>
                </div>

                <div class="pl-filter-group">
                    <label for="plEstadoFilter">Estado</label>
                    <select id="plEstadoFilter" class="pl-filter-input">
                        <option value="Todos">Todos</option>
                        <option value="Aprobado">Aprobado</option>
                    </select>
                </div>
            </div>
            <div id="plResultsCount" class="pl-results-count">Cargando proyectos...</div>
        </div>
    </section>

    <!-- Grilla de Proyectos -->
    <section class="pl-section">
        <div class="container">
            <div id="plProjectsGrid" class="pl-grid">
                <!-- Loading state -->
                <div class="pl-loading" id="plLoadingState">
                    <div class="pl-loading-spinner"></div>
                    <p>Cargando proyectos...</p>
                </div>
            </div>

            <!-- Estado Vacío -->
            <div id="plEmptyState" class="pl-empty-state" style="display:none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <h3>No se encontraron proyectos</h3>
                <p>No hay proyectos presentados que coincidan con tu búsqueda.</p>
                <button class="pl-btn pl-btn-outline" onclick="plResetFilters()">Limpiar filtros</button>
            </div>

            <!-- Error State -->
            <div id="plErrorState" class="pl-empty-state" style="display:none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <h3>Error al cargar proyectos</h3>
                <p>No pudimos obtener los datos. Intentá nuevamente en unos momentos.</p>
                <button class="pl-btn pl-btn-outline" onclick="plLoadProjects()">Reintentar</button>
            </div>

            <!-- Paginación -->
            <nav id="plPagination" class="pl-pagination" aria-label="Paginación de proyectos" style="display:none;"></nav>
        </div>
    </section>

    <!-- CTA Banner -->
    <section class="pl-cta-banner">
        <div class="container">
            <h2>¿Tenés una idea para mejorar Corrientes?</h2>
            <p>La participación ciudadana es clave. Escribinos tu propuesta o inquietud.</p>
            <a href="/contacto/#proponer" class="pl-btn">Proponer una idea</a>
        </div>
    </section>

    <div style="text-align:center; padding: 2rem 0 1rem;">
        <a href="/gestionproyectos/" rel="nofollow"
           style="font-size:12px; color:#aaa; opacity:0.45; text-decoration:none; transition: opacity 0.2s;"
           onmouseover="this.style.opacity='1';this.style.textDecoration='underline'"
           onmouseout="this.style.opacity='0.45';this.style.textDecoration='none'">Acceso interno</a>
    </div>

    <!-- Modal de Detalle -->
    <div id="plModal" class="pl-modal-overlay" aria-hidden="true" role="dialog" aria-labelledby="plModalTitle">
        <div class="pl-modal-content">
            <div class="pl-modal-header">
                <div class="pl-modal-header-info">
                    <div id="plModalBadges" class="pl-card-badges" style="margin-bottom: 0;"></div>
                    <h2 id="plModalTitle">Título del Proyecto</h2>
                </div>
                <button class="pl-btn-close" aria-label="Cerrar modal" onclick="plCloseModal()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="pl-modal-body">
                <div class="pl-modal-section">
                    <h3>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9F57A7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                        Resumen del Proyecto
                    </h3>
                    <p id="plModalSummary">Texto del resumen completo.</p>
                    <div id="plModalTramite" class="pl-modal-tramite" style="display:none;"></div>
                    <div id="plModalAutoria" class="pl-modal-autoria" style="display:none;"></div>
                </div>

                <div class="pl-modal-section" id="plModalDocsSection" style="display:none;">
                    <h3>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1C5CFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                        Documento del Proyecto
                    </h3>
                    <div id="plModalDocsList" class="pl-doc-list">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Vista Previa PDF -->
    <div id="plPreviewModal" class="pl-modal-overlay" aria-hidden="true" role="dialog" aria-label="Vista previa del documento">
        <div class="pl-modal-content pl-preview-modal-content">
            <div class="pl-modal-header">
                <div class="pl-modal-header-info">
                    <h2 id="plPreviewTitle" style="font-size:1rem;">Vista previa</h2>
                </div>
                <button class="pl-btn-close" aria-label="Cerrar vista previa" onclick="plClosePreview()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="pl-preview-body" id="plPreviewBody">
                <div style="text-align:center;color:#838389;padding:3rem;font-size:0.9rem;">Cargando...</div>
            </div>
            <div class="pl-preview-footer">
                <button class="pl-btn pl-btn-outline" onclick="plClosePreview()">Cerrar</button>
                <a id="plPreviewDownloadBtn" href="#" class="pl-btn pl-btn-primary" target="_blank" rel="noopener" style="display:none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Descargar
                </a>
            </div>
        </div>
    </div>

{% block scripts %}
    <script>
    (function() {
        'use strict';

        const API_URL = '/api/projects/public';
        let allProjects = [];
        var currentPage = 1;
        var pageSize = 10;
        var lastFiltered = [];

        // DOM references
        const grid = document.getElementById('plProjectsGrid');
        const emptyState = document.getElementById('plEmptyState');
        const errorState = document.getElementById('plErrorState');
        const loadingState = document.getElementById('plLoadingState');
        const resultsCount = document.getElementById('plResultsCount');
        const searchInput = document.getElementById('plSearchInput');
        const tipoFilter = document.getElementById('plTipoFilter');
        const areaFilter = document.getElementById('plAreaFilter');
        const estadoFilter = document.getElementById('plEstadoFilter');
        const modal = document.getElementById('plModal');
        const paginationEl = document.getElementById('plPagination');

        // ---- Helpers ----
        function escapeHtml(str) {
            if (!str) return '';
            const d = document.createElement('div');
            d.textContent = str;
            return d.innerHTML;
        }

        function getTipoSlug(tipo) {
            if (!tipo) return 'ley';
            const t = tipo.toLowerCase();
            if (t.includes('ley')) return 'ley';
            if (t.includes('resolución') || t.includes('resolucion')) return 'resolucion';
            if (t.includes('declaración') || t.includes('declaracion')) return 'declaracion';
            if (t.includes('informe')) return 'informe';
            if (t.includes('nota')) return 'nota';
            return 'ley';
        }

        function getTipoBadgeClass(tipo) {
            return 'pl-badge-' + getTipoSlug(tipo);
        }

        function formatDate(dateString) {
            if (!dateString) return '';
            try {
                const date = new Date(dateString + 'T00:00:00');
                return date.toLocaleDateString('es-AR', { year: 'numeric', month: 'short', day: 'numeric' });
            } catch (e) {
                return dateString;
            }
        }

        function formatFileSize(bytes) {
            if (!bytes || bytes === 0) return '';
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

        function toTitleCase(str) {
            if (!str) return '';
            return str.trim().replace(/\w\S*/g, function(txt) {
                return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase();
            });
        }

        // ---- Data Loading ----
        async function loadProjects() {
            loadingState.style.display = '';
            emptyState.style.display = 'none';
            errorState.style.display = 'none';
            grid.style.display = '';

            try {
                const res = await fetch(API_URL);
                if (!res.ok) throw new Error('HTTP ' + res.status);
                allProjects = await res.json();

                // Populate area filter dynamically
                populateAreaFilter();

                // Initial render
                filterAndRender();
            } catch (e) {
                loadingState.style.display = 'none';
                grid.style.display = 'none';
                errorState.style.display = '';
                resultsCount.textContent = 'Error al cargar proyectos.';
            }
        }
        // Expose for retry button
        window.plLoadProjects = loadProjects;

        function populateAreaFilter() {
            const areasSet = new Map();
            allProjects.forEach(function(p) {
                if (p.area_tema && p.area_tema.trim()) {
                    const normalized = toTitleCase(p.area_tema.trim());
                    const key = normalized.toLowerCase();
                    if (!areasSet.has(key)) {
                        areasSet.set(key, normalized);
                    }
                }
            });

            // Sort alphabetically
            const sorted = Array.from(areasSet.values()).sort(function(a, b) {
                return a.localeCompare(b, 'es');
            });

            // Rebuild select keeping "Todas" as first option
            areaFilter.innerHTML = '<option value="Todas">Todas</option>';
            sorted.forEach(function(area) {
                var opt = document.createElement('option');
                opt.value = area;
                opt.textContent = area;
                areaFilter.appendChild(opt);
            });
        }

        // ---- Filtering & Rendering ----
        function applyFilters() {
            var q = searchInput.value.toLowerCase().trim();
            var tipo = tipoFilter.value;
            var area = areaFilter.value;
            var estado = estadoFilter.value;

            return allProjects.filter(function(p) {
                var matchSearch = !q ||
                    (p.titulo && p.titulo.toLowerCase().includes(q)) ||
                    (p.resumen && p.resumen.toLowerCase().includes(q)) ||
                    (p.id && p.id.toLowerCase().includes(q)) ||
                    (p.area_tema && p.area_tema.toLowerCase().includes(q));

                var matchTipo = tipo === 'Todos' || p.tipo === tipo;

                var matchArea = area === 'Todas' ||
                    (p.area_tema && toTitleCase(p.area_tema.trim()).toLowerCase() === area.toLowerCase());

                var matchEstado = estado === 'Todos' ||
                    (estado === 'Aprobado' && p.estado_tramite === 'Aprobado');

                return matchSearch && matchTipo && matchArea && matchEstado;
            });
        }

        function filterAndRender(resetPage) {
            if (resetPage !== false) currentPage = 1;
            lastFiltered = applyFilters();
            renderPage();
        }

        function renderPage() {
            var total = lastFiltered.length;
            var totalPages = Math.max(1, Math.ceil(total / pageSize));

            // Clamp currentPage
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            // Clear
            grid.innerHTML = '';
            loadingState.style.display = 'none';

            if (total === 0) {
                grid.style.display = 'none';
                emptyState.style.display = '';
                paginationEl.style.display = 'none';
                resultsCount.textContent = '0 proyectos encontrados';
                return;
            }

            grid.style.display = '';
            emptyState.style.display = 'none';
            errorState.style.display = 'none';

            // Slice for current page
            var start = (currentPage - 1) * pageSize;
            var end = Math.min(start + pageSize, total);
            var pageProjects = lastFiltered.slice(start, end);

            // Results count
            if (total <= pageSize) {
                resultsCount.textContent = 'Mostrando ' + total + ' proyecto' + (total > 1 ? 's' : '');
            } else {
                resultsCount.textContent = 'Mostrando ' + (start + 1) + '–' + end + ' de ' + total + ' proyectos';
            }

            // Render cards
            pageProjects.forEach(function(p) {
                var tipoSlug = getTipoSlug(p.tipo);

                var badgesHtml =
                    '<span class="pl-badge ' + getTipoBadgeClass(p.tipo) + '">' + escapeHtml(p.tipo) + '</span>' +
                    '<span class="pl-badge pl-badge-presentado">Presentado</span>';
                if (p.estado_tramite === 'Aprobado') {
                    badgesHtml += '<span class="pl-badge pl-badge-aprobado">Aprobado</span>';
                }

                var hasDoc = p.has_main_doc || p.has_expediente;
                var docLabel = p.has_expediente ? 'Descargar expediente' : 'Descargar proyecto';
                var btnDescarga = '';
                var btnPreview = '';
                if (hasDoc) {
                    btnDescarga =
                        '<button class="pl-btn pl-btn-outline" onclick="event.stopPropagation(); plDownloadMain(\'' + escapeHtml(p.id) + '\')">' +
                        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>' +
                        docLabel + '</button>';
                    btnPreview =
                        '<button class="pl-btn-preview" onclick="event.stopPropagation(); plOpenPreview(\'' + escapeHtml(p.id) + '\')" title="Vista previa">' +
                        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>' +
                        'Ver expediente</button>';
                }

                // Authorship line
                var autoriaLine = '';
                if (p.tipo_autoria === 'acompanado' && p.autor_principal) {
                    autoriaLine = '<div class="pl-meta-item pl-autoria-line">' +
                        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>' +
                        'Autor: ' + escapeHtml(p.autor_principal) + ' · <em>Acompañado por Cecilia Gortari</em></div>';
                } else if (p.tipo_autoria === 'coautoria' && p.autor_principal) {
                    autoriaLine = '<div class="pl-meta-item pl-autoria-line">' +
                        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>' +
                        'Coautoría: ' + escapeHtml(p.autor_principal) + ' y Cecilia Gortari</div>';
                }

                var card = document.createElement('article');
                card.className = 'pl-card';
                card.setAttribute('data-tipo', tipoSlug);
                card.innerHTML =
                    '<div class="pl-card-badges">' + badgesHtml + '</div>' +
                    '<h3 class="pl-card-title" title="' + escapeHtml(p.titulo) + '">' + escapeHtml(p.titulo) + '</h3>' +
                    '<p class="pl-card-summary">' + escapeHtml(p.resumen) + '</p>' +
                    '<div class="pl-card-meta">' +
                        '<div class="pl-meta-item">' +
                            '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>' +
                            'Área: ' + escapeHtml(p.area_tema || 'Sin definir') +
                        '</div>' +
                        '<div class="pl-meta-item">' +
                            '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>' +
                            'Presentado: ' + formatDate(p.fecha_presentacion) +
                        '</div>' +
                        autoriaLine +
                        '<div class="pl-meta-item" style="margin-top:4px;">' +
                            '<strong style="color:#2C2C31">ID: ' + escapeHtml(p.id) + '</strong>' +
                        '</div>' +
                    '</div>' +
                    '<div class="pl-card-actions">' +
                        '<button class="pl-btn pl-btn-primary" onclick="plOpenModal(\'' + escapeHtml(p.id) + '\')">Ver detalle completo</button>' +
                        btnPreview +
                        btnDescarga +
                    '</div>';

                grid.appendChild(card);
            });

            // Pagination
            renderPagination(total, totalPages);
        }

        // ---- Pagination ----
        function getVisiblePages(current, total) {
            if (total <= 7) {
                var pages = [];
                for (var i = 1; i <= total; i++) pages.push(i);
                return pages;
            }
            if (current <= 3) return [1, 2, 3, 4, '...', total];
            if (current >= total - 2) return [1, '...', total - 3, total - 2, total - 1, total];
            return [1, '...', current - 1, current, current + 1, '...', total];
        }

        function renderPagination(total, totalPages) {
            if (totalPages <= 1) {
                paginationEl.style.display = 'none';
                return;
            }

            paginationEl.style.display = '';
            var pages = getVisiblePages(currentPage, totalPages);
            var html = '';

            // Previous
            html += '<button class="pl-page-btn pl-page-nav" ' +
                (currentPage === 1 ? 'disabled' : 'onclick="plGoToPage(' + (currentPage - 1) + ')"') +
                ' aria-label="Página anterior">' +
                '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>' +
                ' Anterior</button>';

            // Page numbers
            pages.forEach(function(p) {
                if (p === '...') {
                    html += '<span class="pl-page-ellipsis">&hellip;</span>';
                } else {
                    var isActive = p === currentPage;
                    html += '<button class="pl-page-btn' + (isActive ? ' pl-page-active' : '') + '" ' +
                        (isActive ? 'aria-current="page"' : 'onclick="plGoToPage(' + p + ')"') +
                        ' aria-label="Página ' + p + '">' + p + '</button>';
                }
            });

            // Next
            html += '<button class="pl-page-btn pl-page-nav" ' +
                (currentPage === totalPages ? 'disabled' : 'onclick="plGoToPage(' + (currentPage + 1) + ')"') +
                ' aria-label="Página siguiente">Siguiente ' +
                '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>' +
                '</button>';

            paginationEl.innerHTML = html;
        }

        function goToPage(page) {
            var totalPages = Math.max(1, Math.ceil(lastFiltered.length / pageSize));
            if (page < 1 || page > totalPages || page === currentPage) return;
            currentPage = page;
            renderPage();
            // Smooth scroll to top of grid
            grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        window.plGoToPage = goToPage;

        function resetFilters() {
            searchInput.value = '';
            tipoFilter.value = 'Todos';
            areaFilter.value = 'Todas';
            estadoFilter.value = 'Todos';
            filterAndRender();
        }
        window.plResetFilters = resetFilters;

        // Filter listeners — always reset to page 1
        searchInput.addEventListener('input', function() { filterAndRender(); });
        tipoFilter.addEventListener('change', function() { filterAndRender(); });
        areaFilter.addEventListener('change', function() { filterAndRender(); });
        estadoFilter.addEventListener('change', function() { filterAndRender(); });

        // ---- Modal ----
        function openModal(id) {
            var p = allProjects.find(function(x) { return x.id === id; });
            if (!p) return;

            // Header
            document.getElementById('plModalTitle').textContent = p.titulo;

            var badgesHtml =
                '<span class="pl-badge ' + getTipoBadgeClass(p.tipo) + '">' + escapeHtml(p.tipo) + '</span>' +
                '<span class="pl-badge pl-badge-presentado">Presentado</span>';
            if (p.estado_tramite === 'Aprobado') {
                badgesHtml += '<span class="pl-badge pl-badge-aprobado">Aprobado</span>';
            }
            if (p.area_tema) {
                badgesHtml += '<span class="pl-badge" style="background:#ECECF3;color:#4E4E54">' + escapeHtml(p.area_tema) + '</span>';
            }
            document.getElementById('plModalBadges').innerHTML = badgesHtml;

            // Summary
            document.getElementById('plModalSummary').textContent = p.resumen || 'Sin resumen disponible.';

            // Trámite info
            var tramiteEl = document.getElementById('plModalTramite');
            if (p.estado_tramite && p.estado_tramite !== 'Aprobado') {
                tramiteEl.textContent = 'Trámite: ' + p.estado_tramite;
                tramiteEl.style.display = '';
            } else if (p.estado_tramite === 'Aprobado') {
                tramiteEl.textContent = 'Trámite: Aprobado';
                tramiteEl.style.display = '';
            } else {
                tramiteEl.style.display = 'none';
            }

            // Authorship info
            var autoriaEl = document.getElementById('plModalAutoria');
            if (p.tipo_autoria === 'acompanado' && p.autor_principal) {
                autoriaEl.innerHTML =
                    '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:4px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>' +
                    'Autor principal: <strong>' + escapeHtml(p.autor_principal) + '</strong> · Acompañado por Cecilia Gortari';
                autoriaEl.style.display = '';
            } else if (p.tipo_autoria === 'coautoria' && p.autor_principal) {
                autoriaEl.innerHTML =
                    '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:4px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>' +
                    'Coautoría: <strong>' + escapeHtml(p.autor_principal) + '</strong> y Cecilia Gortari';
                autoriaEl.style.display = '';
            } else {
                autoriaEl.style.display = 'none';
            }

            // Docs — fetch from detail endpoint
            var docsSection = document.getElementById('plModalDocsSection');
            var docsList = document.getElementById('plModalDocsList');
            docsSection.style.display = 'none';
            docsList.innerHTML = '<div style="text-align:center;color:#838389;padding:1rem;font-size:0.85rem;">Cargando documentos...</div>';

            fetchDocuments(p.id);

            // Show modal
            modal.classList.add('active');
            modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('pl-modal-open');
            setTimeout(function() {
                var closeBtn = modal.querySelector('.pl-btn-close');
                if (closeBtn) closeBtn.focus();
            }, 100);
        }
        window.plOpenModal = openModal;

        async function fetchDocuments(projectId) {
            var docsSection = document.getElementById('plModalDocsSection');
            var docsList = document.getElementById('plModalDocsList');

            try {
                var res = await fetch(API_URL + '/' + encodeURIComponent(projectId));
                if (!res.ok) throw new Error('HTTP ' + res.status);
                var data = await res.json();

                var doc = data.document;
                docsSection.style.display = '';
                docsList.innerHTML = '';

                if (doc) {
                    var downloadUrl = '/api/projects/public/' + encodeURIComponent(projectId) + '/documents/' + encodeURIComponent(doc.id) + '/download';
                    var previewUrl = '/api/projects/public/' + encodeURIComponent(projectId) + '/documents/' + encodeURIComponent(doc.id) + '/preview';
                    var isPdf = doc.mime_type === 'application/pdf';
                    var docKindLabel = doc.kind === 'expediente' ? 'Expediente' : 'Proyecto';
                    var previewBtnHtml = isPdf
                        ? '<button class="pl-btn-preview" onclick="plShowPreviewDirect(\'' + encodeURIComponent(projectId) + '\', \'' + encodeURIComponent(doc.id) + '\', \'' + escapeHtml(doc.original_name).replace(/'/g, "\\'") + '\')" title="Vista previa">' +
                          '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>' +
                          'Ver ' + docKindLabel + '</button>'
                        : '';
                    docsList.innerHTML =
                        '<div class="pl-doc-item">' +
                            '<div class="pl-doc-info">' +
                                '<div class="pl-doc-icon">' +
                                    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>' +
                                '</div>' +
                                '<div class="pl-doc-details">' +
                                    '<h4>' + escapeHtml(doc.original_name) + '</h4>' +
                                    '<div class="pl-doc-meta">' +
                                        '<span>' + formatFileSize(doc.size_bytes) + '</span>' +
                                        (doc.created_at ? ' &bull; <span>' + formatDate(doc.created_at.split('T')[0]) + '</span>' : '') +
                                    '</div>' +
                                '</div>' +
                            '</div>' +
                            '<div class="pl-doc-actions">' +
                                previewBtnHtml +
                                '<a href="' + downloadUrl + '" class="pl-btn pl-btn-outline" target="_blank" rel="noopener">' +
                                    '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>' +
                                    'Descargar ' + docKindLabel +
                                '</a>' +
                            '</div>' +
                        '</div>';
                } else {
                    docsList.innerHTML =
                        '<p style="color:#838389; font-size:0.9rem; text-align:center; padding:1rem 0;">' +
                            'El documento oficial aún no está disponible para descarga.' +
                        '</p>';
                }
            } catch (e) {
                docsSection.style.display = 'none';
            }
        }

        function closeModal() {
            modal.classList.remove('active');
            modal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('pl-modal-open');
        }
        window.plCloseModal = closeModal;

        // Close on overlay click
        modal.addEventListener('click', function(e) {
            if (e.target === modal) closeModal();
        });

        // Close on Escape
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && modal.classList.contains('active') && !document.getElementById('plPreviewModal').classList.contains('active')) {
                closeModal();
            }
        });

        // ---- Preview ----
        var previewModal = document.getElementById('plPreviewModal');

        function showPreviewDirect(projectId, docId, originalName) {
            var previewUrl = '/api/projects/public/' + projectId + '/documents/' + docId + '/preview';
            var downloadUrl = '/api/projects/public/' + projectId + '/documents/' + docId + '/download';
            var title = document.getElementById('plPreviewTitle');
            var body = document.getElementById('plPreviewBody');
            var dlBtn = document.getElementById('plPreviewDownloadBtn');

            title.textContent = decodeURIComponent(originalName) || 'Vista previa';
            body.innerHTML = '<iframe src="' + previewUrl + '" title="Vista previa del documento"></iframe>';
            dlBtn.href = downloadUrl;
            dlBtn.style.display = '';

            previewModal.classList.add('active');
            previewModal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('pl-modal-open');
        }
        window.plShowPreviewDirect = showPreviewDirect;

        function openPreview(projectId) {
            // Fetch doc data and open preview with priority: expediente > main PDF
            var title = document.getElementById('plPreviewTitle');
            var body = document.getElementById('plPreviewBody');
            var dlBtn = document.getElementById('plPreviewDownloadBtn');

            title.textContent = 'Vista previa';
            body.innerHTML = '<div style="text-align:center;color:#838389;padding:3rem;font-size:0.9rem;">Cargando...</div>';
            dlBtn.style.display = 'none';

            previewModal.classList.add('active');
            previewModal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('pl-modal-open');

            fetch(API_URL + '/' + encodeURIComponent(projectId))
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    var doc = data.document;
                    if (doc && doc.mime_type === 'application/pdf') {
                        var previewUrl = '/api/projects/public/' + encodeURIComponent(projectId) + '/documents/' + encodeURIComponent(doc.id) + '/preview';
                        var downloadUrl = '/api/projects/public/' + encodeURIComponent(projectId) + '/documents/' + encodeURIComponent(doc.id) + '/download';
                        var kindLabel = doc.kind === 'expediente' ? 'Expediente' : 'Documento del Proyecto';

                        title.textContent = kindLabel;
                        body.innerHTML = '<iframe src="' + previewUrl + '" title="Vista previa del documento"></iframe>';
                        dlBtn.href = downloadUrl;
                        dlBtn.style.display = '';
                    } else if (doc) {
                        // Document exists but is not PDF
                        var downloadUrl2 = '/api/projects/public/' + encodeURIComponent(projectId) + '/documents/' + encodeURIComponent(doc.id) + '/download';
                        title.textContent = 'Vista previa';
                        body.innerHTML =
                            '<div class="pl-no-preview">' +
                                '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>' +
                                '<strong>No hay un PDF disponible para vista previa.</strong>' +
                                '<p>El documento está disponible para descarga.</p>' +
                                '<a href="' + downloadUrl2 + '" class="pl-btn pl-btn-outline" target="_blank" rel="noopener" style="margin-top:1rem;text-decoration:none;">' +
                                    '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>' +
                                    ' Descargar documento</a>' +
                            '</div>';
                        dlBtn.style.display = 'none';
                    } else {
                        title.textContent = 'Vista previa';
                        body.innerHTML =
                            '<div class="pl-no-preview">' +
                                '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>' +
                                '<strong>No hay un PDF disponible para vista previa.</strong>' +
                                '<p>El documento oficial aún no está disponible.</p>' +
                            '</div>';
                        dlBtn.style.display = 'none';
                    }
                })
                .catch(function() {
                    body.innerHTML =
                        '<div class="pl-no-preview">' +
                            '<strong>Error al cargar la vista previa.</strong>' +
                            '<p>Intentá nuevamente en unos momentos.</p>' +
                        '</div>';
                    dlBtn.style.display = 'none';
                });
        }
        window.plOpenPreview = openPreview;

        function closePreview() {
            previewModal.classList.remove('active');
            previewModal.setAttribute('aria-hidden', 'true');
            // Only remove modal-open if the detail modal is also closed
            if (!modal.classList.contains('active')) {
                document.body.classList.remove('pl-modal-open');
            }
            // Clear iframe to stop loading
            document.getElementById('plPreviewBody').innerHTML = '';
        }
        window.plClosePreview = closePreview;

        // Close preview on overlay click
        previewModal.addEventListener('click', function(e) {
            if (e.target === previewModal) closePreview();
        });

        // Close preview on Escape (preview takes priority over detail modal)
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && previewModal.classList.contains('active')) {
                e.stopImmediatePropagation();
                closePreview();
            }
        });

        // ---- Download Main Doc ----
        function downloadMain(projectId) {
            fetch(API_URL + '/' + encodeURIComponent(projectId))
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data.document) {
                        var url = '/api/projects/public/' + encodeURIComponent(projectId) + '/documents/' + encodeURIComponent(data.document.id) + '/download';
                        window.open(url, '_blank');
                    }
                })
                .catch(function() {
                    alert('No se pudo descargar el documento. Intentá nuevamente.');
                });
        }
        window.plDownloadMain = downloadMain;

        // ---- Init ----
        document.addEventListener('DOMContentLoaded', loadProjects);
    })();
    </script>
{% endblock %}
